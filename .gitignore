# OJO: las barras iniciales importan. Sin ellas, "data/" tambien capturaria
# "web/data/", que es justo lo que la web publicada necesita para funcionar.

# Cache de FastF1: cientos de MB, se regenera sola
/cache/

# El dataset procesado SI se versiona: pesa 89 KB y evita que la
# actualizacion automatica tenga que reconstruir 126 carreras desde cero.
/data/*
!/data/raw_results.parquet

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
venv/
.venv/

# Firebase
.firebase/
*-debug.log

# Sistema
.DS_Store
Thumbs.db
